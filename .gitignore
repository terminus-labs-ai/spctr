# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local config and session files
*.local.yaml
smoke.yaml
handoff.md
.env

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# uv workspace: one lock at the root; members keep no own lock.
# packages/sr2/uv.lock was deleted at the assembly commit but stays in
# history, so `git log --follow packages/sr2/uv.lock` still works.
packages/*/uv.lock

